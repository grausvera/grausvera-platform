APP_ROLE=web
DATABASE_URL=postgresql://grausvera:local-password@127.0.0.1:5432/grausvera
LOG_LEVEL=info
MESSAGING_EMITTER_ENABLED=false
META_ACCESS_TOKEN=replace-with-meta-access-token
