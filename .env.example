APP_ROLE=web
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://grausvera:local-password@127.0.0.1:5432/grausvera
LOG_LEVEL=info
MESSAGING_EMITTER_ENABLED=false
META_ACCESS_TOKEN=replace-with-meta-access-token
META_APP_SECRET=replace-with-meta-app-secret
META_GRAPH_BASE_URL=https://graph.facebook.com
META_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
META_PROVIDER_CONNECTION_ID=00000000-0000-4000-8000-000000000001
META_WEBHOOK_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
NODE_ENV=development
OPERATOR_EMAIL=operator@example.com
OPERATOR_NAME=grausvera-operator
OPERATOR_ORGANIZATION_SLUG=grausvera
OPERATOR_PASSWORD=replace-with-a-strong-local-password
PORT=3000
PUBLIC_CONTACT_EMAIL=contact@example.com
EMAIL_EMITTER_ENABLED=false
EMAIL_SECRET_KEY_REFERENCE=email-transient-v1
# EMAIL_SECRET_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
# RESEND_API_KEY=replace-with-resend-api-key
RESEND_BASE_URL=https://api.resend.com
# RESEND_FROM=grausvera <notify@example.com>
PUBLIC_WHATSAPP_USERNAME=example.brand
POSTGRES_PORT=5432
S3_ENDPOINT=http://127.0.0.1:9090
S3_BUCKET=grausvera-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key
S3_PORT=9090
